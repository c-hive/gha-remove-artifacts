{
  "name": "gha-remove-artifacts",
  "version": "1.8.0",
  "description": "GitHub Action to remove old artifacts",
  "main": "dist/index.js",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node24 --format=esm --minify --outfile=dist/index.js --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "dev": "env INPUT_DRY-RUN=true node --env-file=.env src/index.ts",
    "test": "node --test 'src/**/*.test.ts'",
    "typecheck": "tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "keywords": [
    "github",
    "action",
    "remove",
    "artifact"
  ],
  "author": "c-hive",
  "license": "MIT",
  "//dependencies": {
    "@actions/core": "read action inputs, report failure",
    "@octokit/action": "GitHub API client, authenticates with the workflow token",
    "@octokit/plugin-throttling": "respect rate limits, retry",
    "moment": "parse the `age` input, compare dates"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@octokit/action": "^8.0.4",
    "@octokit/plugin-throttling": "^11.0.5",
    "moment": "^2.31.0"
  },
  "//devDependencies": {
    "@types/node": "Node.js types",
    "esbuild": "bundle src/ and dependencies into dist/index.js",
    "eslint*": "code style",
    "globals": "Node.js globals for ESLint",
    "prettier": "code formatting",
    "typescript": "type checking; Node runs the .ts sources directly",
    "typescript-eslint": "ESLint support for TypeScript"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.34.4",
  "type": "module"
}
